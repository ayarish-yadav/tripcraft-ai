PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/tripcraft
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free planner is the default. Gemini is optional and consumes your project's quota if enabled.
GEMINI_ENABLED=false

# Explicit demo server: serves the website without database or AI
DEMO_MODE=false
# Set only when hosting behind a known reverse proxy such as Render
TRUST_PROXY_HOPS=0
